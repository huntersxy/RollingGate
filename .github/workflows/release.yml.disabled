name: Upload Release Asset
on:
  workflow_dispatch:
  release:
    types: [ published ]

jobs:
  build:
    permissions: write-all
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include:
          - { mcversion: "1.21.1", mc-index: 0, java: "21", game-versions: "1.21.1" }
          - { mcversion: "1.21.8", mc-index: 1, java: "21", game-versions: "1.21.8" }
          - { mcversion: "1.21.10", mc-index: 2, java: "21", game-versions: "1.21.10" }
          - { mcversion: "26.1.2", mc-index: 3, java: "25", game-versions: "26.1.2" }
          - { mcversion: "26.2", mc-index: 4, java: "25", game-versions: "26.2" }
    env:
      # Build numbers keep maven coordinates distinct between Minecraft versions
      CI_BUILD: true
      PR_BUILD: false
      VERSION_TYPE: ${{ github.event.release.prerelease && 'beta' || 'release' }}
    steps:
      - name: checkout
        uses: actions/checkout@v4

      - name: validate gradle wrapper
        uses: gradle/actions/wrapper-validation@v3

      - name: Setup Java ${{ matrix.java }}
        uses: actions/setup-java@v3.6.0
        with:
          distribution: zulu
          java-version: ${{ matrix.java }}

      - name: make gradle wrapper executable
        if: ${{ runner.os != 'Windows' }}
        run: chmod +x ./gradlew

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v3

      - name: Build
        run: ./gradlew :${{ matrix.mcversion }}:build -Pmc_index=${{ matrix.mc-index }}

      - name: Get Version
        id: version
        run: |
          JAR=$(ls versions/${{ matrix.mcversion }}/build/libs/*.jar | grep -v sources.jar)
          VERSION=$(basename "$JAR" .jar | sed "s/^RollingGate-neoforge-${{ matrix.mcversion }}-//")
          echo "jar=$(basename "$JAR")" >> $GITHUB_OUTPUT
          echo "version=$VERSION" >> $GITHUB_OUTPUT

      - name: Upload Release Jar
        uses: softprops/action-gh-release@v0.1.15
        with:
          files: |
            versions/${{ matrix.mcversion }}/build/libs/${{ steps.version.outputs.jar }}

      - name: Publish to maven
        run: ./gradlew :${{ matrix.mcversion }}:publish -Pmc_index=${{ matrix.mc-index }}
        env:
          MAVEN_URL: ${{ secrets.MAVEN_URL }}
          MAVEN_USERNAME: ${{ secrets.MAVEN_USER }}
          MAVEN_PASSWORD: ${{ secrets.MAVEN_PASS }}
        continue-on-error: true

      - name: publish neoforge mc mod
        uses: Kir-Antipov/mc-publish@v3.3
        continue-on-error: true
        with:
          name: "${{ matrix.game-versions }} | RollingGate v${{ steps.version.outputs.version }}"
          version: ${{ steps.version.outputs.version }}
          game-versions: ${{ matrix.game-versions }}
          version-type: ${{ env.VERSION_TYPE }}
          java: ${{ matrix.java }}
          loaders: neoforge
          fail-mode: skip
          changelog: ${{ github.event.release.body }}

          modrinth-id: HXsmHiKu
          modrinth-token: ${{ secrets.MODRINTH_TOKEN }}
          modrinth-featured: true

          curseforge-id: 1194894
          curseforge-token: ${{ secrets.CURSEFORGE_TOKEN }}

          files: |
            versions/${{ matrix.mcversion }}/build/libs/${{ steps.version.outputs.jar }}
            versions/${{ matrix.mcversion }}/build/libs/${{ steps.version.outputs.jar }}-sources.jar
